# ─── Font ─────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 12
font-thicken = true
adjust-cell-height = 15%
font-feature = +calt
font-feature = +liga

# ─── Window ───────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 4
window-padding-balance = true
window-padding-color = extend
window-decoration = true
window-save-state = default
window-subtitle = working-directory
macos-titlebar-style = tabs
macos-option-as-alt = true
confirm-close-surface = false
quit-after-last-window-closed = true
quick-terminal-screen = mouse
quick-terminal-position = top
keybind = global:ctrl+grave_accent=toggle_quick_terminal

window-theme = ghostty

# ─── Shell ────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = true

# Smart launcher: starts tmux dev on first launch, plain shell after
command = /bin/zsh -l -c '$HOME/.config/ghostty/ghostty-tmux.sh'

# ─── Clipboard ────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# ─── Cursor ───────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
cursor-color = #b8bfd0
cursor-text = #1d2133

# ─── Mouse ────────────────────────────────────────────────
mouse-hide-while-typing = true
link-url = true

# ─── Theme & Colors ───────────────────────────────────────
theme = KJM Steel
background = #1d2133
background-opacity = 0.95
background-blur-radius = 20
selection-background = #384263
selection-foreground = #d0d6e4

# ─── Misc ─────────────────────────────────────────────────
auto-update = download
resize-overlay = always
scrollback-limit = 100000
clipboard-trim-trailing-spaces = true
window-colorspace = display-p3

# ─── tmux Integration ────────────────────────────────────
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = alt+up=unbind
keybind = alt+down=unbind
keybind = alt+one=unbind
keybind = alt+two=unbind
keybind = alt+three=unbind
keybind = alt+four=unbind
keybind = alt+five=unbind
